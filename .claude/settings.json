{
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "$CLAUDE_PROJECT_DIR/.claude/hooks/push-guard.mjs"
                                                       }
                                                   ]
                                     }
                                 ],
                  "SessionStart":  [
                                       {
