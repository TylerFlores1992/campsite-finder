# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# THROWAWAY probe scripts. The pattern used all over this project is to write
# `scripts/.something.mts`, run it with tsx, then `rm -f` it — the leading dot marks it as
# scratch. That is fine until an unrelated `git add -A` runs in the window between the
# write and the delete, which is exactly how `scripts/.w.mts` got committed on 2026-08-08
# and then showed up as a phantom deletion in the next status. Ignore them by shape so the
# race cannot commit one.
scripts/.*.mts
scripts/.*.ts

# one-off local scripts that may contain secrets
scripts/fix-exec-dml.mjs

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/apply-migration-004.mjs

# clerk configuration (can include secrets)
/.clerk/

# capacitor native projects (generated locally with `npx cap add ios|android`;
# built in Xcode / Android Studio — see docs/SETUP.md)
/ios/
/android/
.seo-check/

# scratch render from `npx tsx scripts/screenshot-component.mts <preset>` (its default
# --out). An image of a component at one moment, regenerated on demand — not source,
# and it lands in the repo root every time anyone eyeballs a component.
/screenshot.png

# store assets from `npx tsx scripts/play-assets.mts` — a pure downscale of
# assets/icon-only.png and a composite of the same source, regenerated on demand for a
# Play or tester-service upload form. Derived output, not source: committing it would
# mean two copies of the brand mark that can silently disagree, and the one in assets/
# is the one @capacitor/assets builds the launcher icons from.
/.play-assets/
